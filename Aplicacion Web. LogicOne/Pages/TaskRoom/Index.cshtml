@page
@model Aplicacion_Web._LogicOne.Pages.TaskRoom.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Tareas</h1>

<p>
    <a asp-page="Create">Crear Nueva Tarea</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TaskManagerDB[0].TitleTask)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TaskManagerDB[0].DescriptionTask)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TaskManagerDB[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TaskManagerDB[0].FechaCreacion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.TaskManagerDB) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TitleTask)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DescriptionTask)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaCreacion)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.ID">Editar</a> |
                <a asp-page="./Details" asp-route-id="@item.ID">Detalles</a> |
                <a asp-page="./Delete" asp-route-id="@item.ID">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
