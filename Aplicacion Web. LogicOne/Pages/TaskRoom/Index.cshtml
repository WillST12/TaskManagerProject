@page
@model Aplicacion_Web._LogicOne.Pages.TaskRoom.IndexModel

@{
    ViewData["Title"] = "Tareas";
}

<h1 class="mb-4 text-primary">Mis Tareas</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill"></i> Nueva Tarea
    </a>
</p>

@if (!Model.TaskManagerDB.Any())
{
    <div class="alert alert-info" role="alert">
        No tienes tareas pendientes.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model.TaskManagerDB)
        {
            var estado = item.Status ? "Completada"
            : item.FechaLimite < DateTime.Now ? "Vencida"
            : "Pendiente";

            var badgeClass = item.Status ? "success"
            : item.FechaLimite < DateTime.Now ? "danger"
            : "warning text-dark";

            <div class="col">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">@item.TitleTask</h5>
                        <p class="card-text">@item.DescriptionTask</p>

                        <span class="badge bg-@badgeClass mb-2">@estado</span>

                        <p class="mb-1"><strong>Creada:</strong> @item.FechaCreacion.ToString("dd/MM/yyyy hh:mm tt")</p>
                        <p class="mb-3"><strong>Vence:</strong> @item.FechaLimite.ToString("dd/MM/yyyy hh:mm tt")</p>

                        <div class="d-flex flex-wrap gap-2">
                            <form method="post" asp-page-handler="Completar" asp-route-id="@item.ID">
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="bi bi-check-circle-fill"></i> Completa
                                </button>
                            </form>

                            <a asp-page="./Edit" asp-route-id="@item.ID" class="btn btn-info btn-sm">
                                <i class="bi bi-pencil-fill"></i> Editar
                            </a>

                            <a asp-page="./Details" asp-route-id="@item.ID" class="btn btn-secondary btn-sm">
                                <i class="bi bi-info-circle-fill"></i> Detalles
                            </a>

                            <a asp-page="./Delete" asp-route-id="@item.ID" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash-fill"></i> Eliminar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>
}
