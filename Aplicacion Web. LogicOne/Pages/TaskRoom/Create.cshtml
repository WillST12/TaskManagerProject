@page
@model Aplicacion_Web._LogicOne.Pages.TaskRoom.CreateModel

@{
    ViewData["Title"] = "Nueva tarea";
}

<h1 class="mb-4">Nueva tarea</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="TaskManagerDB.TitleTask" class="form-label"></label>
            <input asp-for="TaskManagerDB.TitleTask" class="form-control" />
            <span asp-validation-for="TaskManagerDB.TitleTask" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="TaskManagerDB.DescriptionTask" class="form-label"></label>
            <input asp-for="TaskManagerDB.DescriptionTask" class="form-control" />
            <span asp-validation-for="TaskManagerDB.DescriptionTask" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="TaskManagerDB.FechaLimite" class="form-label"></label>
            <input asp-for="TaskManagerDB.FechaLimite" type="datetime-local" class="form-control" />
            <span asp-validation-for="TaskManagerDB.FechaLimite" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-success">Guardar</button>
        <a asp-page="Index" class="btn btn-secondary ms-2">Cancelar</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>
}