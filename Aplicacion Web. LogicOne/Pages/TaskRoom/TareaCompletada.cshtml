@page
@model Aplicacion_Web._LogicOne.Pages.TaskRoom.TareaCompletadaModel

@{
    ViewData["Title"] = "Tareas Completadas"; // Título de la página
}

<h1 >Tareas Completadas</h1>


@if (!Model.TaskManagerDB.Any())
{
    <div class="alert alert-info" role="alert">
       Aun no tienes tareas completadas. ¡Es hora de ponerte a trabajar!
    </div>
}
else
{

    <table class="table table-hover table-striped bg-white shadow rounded">

        <thead>
            <tr>
                <th width="15%">
                    @Html.DisplayNameFor(model => model.TaskManagerDB[0].TitleTask)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TaskManagerDB[0].DescriptionTask)
                </th>
                <th class="text-center">
                    @Html.DisplayNameFor(model => model.TaskManagerDB[0].Status)
                </th>
                <th>
                   Finalizacion
                </th>
                <th class="text-center">Acciones</th> 
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.TaskManagerDB)
            {
                <tr>
                    <td>
                        <strong>@Html.DisplayFor(modelItem => item.TitleTask)</strong>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DescriptionTask)
                    </td>
                    <td class="text-center">
                       
                        <span class="badge bg-success">Completada ✅</span>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FechaLimite)
                    </td>
                    <td class="text-center">
                       
                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.ID" style="display:inline;">
                         
                            <button type="button" class="btn btn-danger btn-md  " data-toggle="modal" data-target="#exampleModal">
                                <p>Eliminar</p>
                            </button>

                            <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                                <div class="modal-dialog" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="exampleModalLabel">Estas seguro de que deseas eliminar la tarea?</h5>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <div class="modal-body">
                                            <p> Ojo ¡No podras remover esta accion!</p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                                            <div>
                                                <button type="submit" class="btn btn-danger btn-md" title="Eliminar Tarea"
                                                       ;">
                                                    Eliminar
                                                </button>
                                            </div>
										
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>                       
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>
}
