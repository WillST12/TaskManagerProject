@page
@model Aplicacion_Web._LogicOne.Pages.TaskRoom.TareaCompletadaModel

@{
    ViewData["Title"] = "Tareas Completadas"; // Título de la página
}

<h1>Tareas Completadas</h1>

@* Verifica si hay tareas completadas para mostrar un mensaje apropiado *@
@if (!Model.TaskManagerDB.Any())
{
    <div class="alert alert-info" role="alert">
       Aun no tienes tareas completadas. ¡Es hora de ponerte a trabajar!
    </div>
}
else
{
    @* Tabla para mostrar las tareas completadas con estilos de Bootstrap *@
    <table class="table table-hover table-striped">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.TaskManagerDB[0].TitleTask)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TaskManagerDB[0].DescriptionTask)
                </th>
                <th class="text-center">
                    @Html.DisplayNameFor(model => model.TaskManagerDB[0].Status)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TaskManagerDB[0].FechaCreacion)
                </th>
                <th class="text-center">Acciones</th> 
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.TaskManagerDB)
            {
                <tr>
                    <td>
                        <strong>@Html.DisplayFor(modelItem => item.TitleTask)</strong>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DescriptionTask)
                    </td>
                    <td class="text-center">
                       
                        <span class="badge bg-success">Completada ✅</span>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FechaCreacion)
                    </td>
                    <td class="text-center">
                       
                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.ID" style="display:inline;">
                            <button type="submit" class="btn btn-danger btn-sm" title="Eliminar Tarea"
                                    onclick="return confirm('¿Estás seguro de que quieres eliminar esta tarea?');">
                                <i class="bi bi-trash-fill"></i> Eliminar
                            </button>
                        </form>
                       
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

}
