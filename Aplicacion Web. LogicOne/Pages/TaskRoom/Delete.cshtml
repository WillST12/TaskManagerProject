@page
@model Aplicacion_Web._LogicOne.Pages.TaskRoom.DeleteModel

@{
    ViewData["Title"] = "Eliminar Tarea";
}

<div class="container mt-5">
    <div class="card shadow-lg border-danger">
        <div class="card-header bg-danger text-white d-flex align-items-center">
            <i class="bi bi-trash-fill me-2 fs-4"></i>
            <h4 class="mb-0">Eliminar Tarea</h4>
        </div>

        <div class="card-body">
            <div class="alert alert-warning d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i>
                <div>
                    ¿Estás seguro de que deseas eliminar esta tarea? Esta acción no se puede deshacer.
                </div>
            </div>

            <dl class="row mb-4">
                <dt class="col-sm-4 text-end fw-bold text-muted">
                    @Html.DisplayNameFor(model => model.TaskManagerDB.TitleTask)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.TaskManagerDB.TitleTask)
                </dd>

                <dt class="col-sm-4 text-end fw-bold text-muted">
                    @Html.DisplayNameFor(model => model.TaskManagerDB.DescriptionTask)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.TaskManagerDB.DescriptionTask)
                </dd>

                <dt class="col-sm-4 text-end fw-bold text-muted">
                    @Html.DisplayNameFor(model => model.TaskManagerDB.FechaCreacion)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.TaskManagerDB.FechaCreacion)
                </dd>

                <dt class="col-sm-4 text-end fw-bold text-muted">
                    @Html.DisplayNameFor(model => model.TaskManagerDB.FechaLimite)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.TaskManagerDB.FechaLimite)
                </dd>
            </dl>

            <form method="post" class="d-flex justify-content-between">
                <input type="hidden" asp-for="TaskManagerDB.ID" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Eliminar
                </button>
                <a asp-page="./Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Volver atrás
                </a>
            </form>
        </div>
    </div>
</div>
