@page
@model Aplicacion_Web._LogicOne.Pages.TaskRoom.DetailsModel

@{
    ViewData["Title"] = "Detalles de la Tarea";
}

<div class="container mt-5">
    <h2 class="mb-4 text-primary fw-bold">
        <i class="bi border-info"></i> Detalles de la Tarea
    </h2>

    <div class="card shadow-sm rounded-4 p-4">
        <div class="mb-4">
            <h4 class="fw-semibold">
                <i class="bi bi-card-text me-2 text-secondary"></i>
                @Model.TaskManagerDB.TitleTask
            </h4>
        </div>

        <div class="mb-4">
            <h6 class="text-muted mb-1"><i class="bi bi-journal-text me-2"></i>Descripción</h6>
            <p class="fs-5">@Model.TaskManagerDB.DescriptionTask</p>
        </div>

        <div class="mb-4">
            <h6 class="text-muted mb-1"><i class="bi bi-calendar-plus me-2"></i>Fecha de creación</h6>
            <p class="fs-5">@Model.TaskManagerDB.FechaCreacion.ToString("dddd, dd MMMM yyyy - HH:mm")</p>
        </div>

        <div class="mb-4">
            <h6 class="text-muted mb-1"><i class="bi bi-calendar-event me-2"></i>Fecha límite</h6>
            <p class="fs-5">@Model.TaskManagerDB.FechaLimite.ToString("dddd, dd MMMM yyyy - HH:mm")</p>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-page="./Edit" asp-route-id="@Model.TaskManagerDB.ID" class="btn btn-outline-primary rounded-pill">
                <i class="bi bi-pencil-square me-2"></i>Editar
            </a>
            <a asp-page="./Index" class="btn btn-outline-secondary rounded-pill">
                <i class="bi bi-arrow-left-circle me-2"></i>Volver a la lista
            </a>
        </div>
    </div>
</div>
