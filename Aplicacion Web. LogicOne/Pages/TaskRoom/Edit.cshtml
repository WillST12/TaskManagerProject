@page
@model Aplicacion_Web._LogicOne.Pages.TaskRoom.EditModel

@{
    ViewData["Title"] = "Editar Tarea";
}

<div class="container mt-5">
    <h2 class="mb-4">Editar Tarea</h2>

    <div class="card shadow-lg rounded-3">
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="TaskManagerDB.ID" />

                <div class="mb-3">
                    <label asp-for="TaskManagerDB.TitleTask" class="form-label">Título</label>
                    <input asp-for="TaskManagerDB.TitleTask" class="form-control" placeholder="Escribe el título de la tarea" />
                    <span asp-validation-for="TaskManagerDB.TitleTask" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TaskManagerDB.DescriptionTask" class="form-label">Descripción</label>
                    <textarea asp-for="TaskManagerDB.DescriptionTask" class="form-control" rows="3" placeholder="Describe brevemente la tarea"></textarea>
                    <span asp-validation-for="TaskManagerDB.DescriptionTask" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TaskManagerDB.FechaLimite" class="form-label">Fecha Límite</label>
                    <input asp-for="TaskManagerDB.FechaLimite" type="datetime-local" class="form-control" />
                    <span asp-validation-for="TaskManagerDB.FechaLimite" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
