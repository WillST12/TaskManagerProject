@page
@model Aplicacion_Web._LogicOne.Pages.TaskRoom.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>TaskManagerDB</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="TaskManagerDB.ID" />
            <div class="form-group">
                <label asp-for="TaskManagerDB.TitleTask" class="control-label"></label>
                <input asp-for="TaskManagerDB.TitleTask" class="form-control" />
                <span asp-validation-for="TaskManagerDB.TitleTask" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TaskManagerDB.DescriptionTask" class="control-label"></label>
                <input asp-for="TaskManagerDB.DescriptionTask" class="form-control" />
                <span asp-validation-for="TaskManagerDB.DescriptionTask" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-check-label" asp-for="TaskManagerDB.FechaLimite"></label>
                <input class="form-check-input" asp-for="TaskManagerDB.FechaLimite" type="datetime-local" />
                <span asp-validation-for="TaskManagerDB.FechaLimite" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Cancelar</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
